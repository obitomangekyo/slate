# LOCAL DEVELOPMENT
# Copy this file to the repository root as .env. Do not commit your real .env.
# The API dev command and the web app both load this root file.
# Values in this section are for local development; GitHub Actions does not read this file.

# WEB APP: public values used by the browser build. These are not secrets.
# Required for deployed web builds; optional for local development.
VITE_API_URL=http://localhost:3001
# Optional: public site origin used for page metadata.
VITE_SITE_URL=http://localhost:3000
# Optional: leave blank to disable browser error reporting.
VITE_SENTRY_DSN=
# Optional: defaults to development locally. Set to development, test, or production.
VITE_SENTRY_ENVIRONMENT=development
# Optional: public GlitchTip security endpoint. Leave blank when not using GlitchTip.
VITE_SENTRY_SECURITY_ENDPOINT=

# API SERVER: required values unless marked optional. These must be kept private.
# Required: local MongoDB connection string, or use a private hosted database URI.
MONGODB_URI=mongodb://127.0.0.1:27017/slate
# Required: use separate random values of at least 32 characters each.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
EMAIL_VERIFICATION_SECRET=replace-with-another-random-secret-at-least-32-characters
# Required by the current API configuration for Google sign-in.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# Required: Gmail account used to send verification messages.
MAIL_USER=you@example.com
MAIL_PASSWORD=replace-with-your-gmail-app-password

# API SERVER: optional locally; defaults are shown here for clarity.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
# Public web origin and Google OAuth callback. These have local defaults.
WEB_APP_URL=http://localhost:3000
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# GITHUB ACTIONS: add these to repository Environments: development, staging, and production.
# Configure each environment with that environment's own app names, URLs, and credentials.
# Development and staging deploy automatically after CI; production promotion is manual.
# Settings below marked required are checked by the relevant deploy workflow.

# GitHub Environment VARIABLES: no secret masking needed. Configure these separately in
# development, staging, and production. Production promotes the latest successful staging
# commit and requires it to be merged into main.
# Required. Deployed Fly app names for each environment.
# FLY_WEB_APP=your-web-app-name
# FLY_API_APP=your-api-app-name
# Required. Public API origin used by the deployed web build, for example https://api.example.com.
# VITE_API_URL=https://your-api-host
# Required. Public web origin used by API links and CORS, for example https://example.com.
# WEB_APP_URL=https://your-web-host
# Required. Must exactly match the callback URL registered in the Google OAuth client.
# GOOGLE_REDIRECT_URI=https://your-web-host/api/auth/google/callback
# Optional. Public site origin used for metadata; commonly the same as WEB_APP_URL.
# VITE_SITE_URL=https://your-web-host
# Optional. Browser error reporting. Leave unset to disable GlitchTip reporting.
# VITE_SENTRY_DSN=
# Optional. Defaults to development on dev and production on staging/production.
# VITE_SENTRY_ENVIRONMENT=development
# Optional. Public GlitchTip security endpoint.
# VITE_SENTRY_SECURITY_ENDPOINT=

# GitHub Environment SECRETS: required and private. The deploy workflows import the API
# settings into the matching Fly app as Fly secrets. Use separate signing keys for each purpose.
# Required: one Fly deploy token per app, used by its respective deployment step.
# FLY_API_TOKEN_WEB=your-web-app-fly-deploy-token
# FLY_API_TOKEN_API=your-api-app-fly-deploy-token
# Required API runtime secrets/settings. These are also copied to the Fly API app.
# MONGODB_URI=your-private-mongodb-connection-string
# JWT_ACCESS_SECRET=your-random-secret-at-least-32-characters
# JWT_REFRESH_SECRET=your-different-random-secret-at-least-32-characters
# EMAIL_VERIFICATION_SECRET=your-another-random-secret-at-least-32-characters
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# MAIL_USER=your-sending-mail-account
# MAIL_PASSWORD=your-mail-provider-app-password

# DEPLOYMENT NOTES
# Create the GitHub Environments named development, staging, and production. The automatic
# workflow selects development/staging based on branch; production is started manually from
# Actions after staging passes its release and CI gates. Set each environment's variables
# and secrets in GitHub Settings. Protect production with required reviewers if desired.
# Do not add PORT or CORS_ORIGINS in GitHub: Fly sets PORT in apps/api/fly.toml, and the
# deploy workflow sets CORS_ORIGINS to WEB_APP_URL before importing API secrets into Fly.
# VITE_* values are embedded in the public web build. Never put private credentials in them.

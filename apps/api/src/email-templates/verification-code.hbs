<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Verify your Slate account</title>
  </head>
  <body style="margin:0;background:#f4f1e9;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#192522;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f1e9;padding:40px 16px;">
      <tr><td align="center">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:520px;background:#fffefa;border:1px solid #dedbd1;border-radius:8px;overflow:hidden;">
          <tr><td style="padding:28px 32px 20px;">
            <table role="presentation" cellspacing="0" cellpadding="0"><tr>
              <td><span style="display:block;width:12px;height:12px;background:#36584f;border-radius:3px;"></span></td>
              <td style="padding-left:10px;font-size:16px;font-weight:700;letter-spacing:-.02em;">Slate</td>
            </tr></table>
          </td></tr>
          <tr><td style="padding:8px 32px 36px;">
            <p style="margin:0 0 10px;color:#64716c;font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;">One quick step</p>
            <h1 style="margin:0 0 14px;font-size:25px;line-height:1.25;letter-spacing:-.035em;">Verify your email</h1>
            <p style="margin:0 0 24px;color:#53615c;font-size:15px;line-height:1.65;">Use this six-character code to finish setting up your Slate account. Enter it exactly as shown. It expires in 10 minutes.</p>
            {{!-- The code is inserted as escaped text so it cannot become email markup. --}}
            <div style="padding:20px 16px;background:#f0f3ed;border:1px solid #dce4db;border-radius:6px;text-align:center;">
              <span style="color:#23483e;font-family:'SFMono-Regular',Consolas,monospace;font-size:32px;font-weight:700;letter-spacing:.24em;">{{code}}</span>
            </div>
            <p style="margin:22px 0 0;color:#75807b;font-size:12px;line-height:1.6;">You&apos;re receiving this because someone started creating a Slate account with <strong style="color:#45534e;">{{email}}</strong>. If that wasn&apos;t you, you can ignore this message.</p>
          </td></tr>
          <tr><td style="padding:17px 32px;border-top:1px solid #e8e5dc;color:#858d88;font-size:11px;">Slate · Thoughtful work, together</td></tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>

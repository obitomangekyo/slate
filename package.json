{
  "name": "slate-engine",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint && biome check .",
    "lint:ci": "oxlint && biome ci .",
    "lint:fix": "oxlint --fix && biome check --write .",
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "build": "pnpm --filter @slate/shared build && pnpm --filter \"./apps/*\" build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.6",
    "lefthook": "2.2.2",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.19.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.19.0",
  "type": "module"
}

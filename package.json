{
  "name": "slate",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint && biome check .",
    "lint:ci": "oxlint && biome ci .",
    "lint:fix": "oxlint --fix && biome check --write .",
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "build": "pnpm --filter @slate/shared build && pnpm --filter \"./apps/*\" build"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "@zxcvbn-ts/core": "^4.3.0",
    "@zxcvbn-ts/language-common": "^4.2.0",
    "@zxcvbn-ts/language-en": "^4.1.2",
    "axios": "^1.21.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.6",
    "lefthook": "2.2.2",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module"
}
